# =============================================================================
# AI/ML Provider APIs
# =============================================================================

# Google Gemini API key 
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# KISSKI Academic Cloud API key for KISSKI extractor
# Required for kisski-neural-chat extractor to be available
# Get access at: https://kisski.gwdg.de/
KISSKI_API_KEY=

# Huggingface Token
HF_TOKEN=


# =============================================================================
# Experiment Tracking (optional)
# Install extras: uv sync --extra wandb   and/or   uv sync --extra mlflow
# =============================================================================

# Weights & Biases — set WANDB_API_KEY to enable tracking with W&B
# Get your API key at: https://wandb.ai/settings
WANDB_API_KEY=
WANDB_PROJECT=tei-annotator
# WANDB_ENTITY=<your-team-or-username>    # optional; defaults to personal workspace

# MLFlow / GitLab — set MLFLOW_TRACKING_URI to enable tracking with MLFlow
# For GitLab-hosted MLFlow the URI is:
#   https://gitlab.com/api/v4/projects/<project-id>/ml/mlflow
# Authenticate with a GitLab personal access token (scope: api).
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_TOKEN=
MLFLOW_EXPERIMENT_NAME=tei-annotator

